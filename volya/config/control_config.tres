[gd_resource type="Resource" script_class="ControlConfig" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/control_config.gd" id="1_cfg"]

; Hodnoty namerane Pavlom na Samsungu SM-S731B (450 dpi, 11.81 px/mm)
; pocas F1, 2026-07-31. Vypis z tlacidla VYPIS DO LOGU, build 7a16079.
; NEMENIT ODHADOM - menit len podla dalsieho merania na zariadeni.
;
; run_saturation je rozdeleny na strany az po tomto merani: kotva vznika pri
; lavom okraji displeja, takze dolava nie je kam palcom cuvat.

[resource]
script = ExtResource("1_cfg")
j0_mm = 9.0
reach_mm = 10.5
rise_left_mm = 6.0
drop_right_mm = 10.0
j_min_mm = 0.0
hysteresis_mm = 0.0
run_deadzone_mm = 1.5
run_saturation_left_mm = 5.0
run_saturation_right_mm = 15.0
aim_deadzone_mm = 2.5
aim_recenter_mm = 12.0
aim_turn_pull = 0.0
; Aiming from the character, tried against the anchored stick on device
; 2026-08-03 and clearly better. The stick's lever was ~12 mm, so a millimetre
; of tremor threw the shots wide; from the character it is 30-60 mm.
aim_from_character = true
aim_origin_min_mm = 9.0
; The movement pad no longer covers the whole left half. Aiming with the right
; index finger reaches down-left, where a touch used to be taken as movement
; and the shot never happened.
move_zone_width = 0.5
move_zone_bottom = 0.28
; Free movement is OFF by default: it is a prototype to be compared against
; jumping on the phone, not a decision yet. Toggle it in the panel.
free_movement = false
free_move_y_ratio = 0.62
